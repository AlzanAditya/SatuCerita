# Domain produksi (tanpa trailing slash). Dipakai untuk canonical, Open Graph,
# sitemap.xml, dan robots.txt. Default: https://satucerita.zanxa.studio
VITE_SITE_URL="https://satucerita.zanxa.studio"

# (Opsional) Base URL API Worker. Kosongkan jika Worker berjalan di domain yang sama
# (route /api/* di tiap host) atau lewat proxy Vite saat dev.
# VITE_API_BASE_URL=""

# Catatan: kunci Supabase TIDAK dipakai di frontend. Semua akses lewat Worker.
# Lihat worker/.dev.vars.example dan docs/SETUP-AUTH.md
